{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "semanticVersion": "2.26.2",
          "rules": [
            {
              "id": "java/command-line-injection",
              "shortDescription": {"text": "Command built from user-controlled sources"},
              "fullDescription": {"text": "Passing user-controlled data to a command execution API permits command injection."},
              "defaultConfiguration": {"level": "error"},
              "properties": {
                "tags": ["security", "external/cwe/cwe-078"],
                "precision": "high",
                "problem.severity": "error",
                "security-severity": "9.8"
              }
            }
          ]
        }
      },
      "invocations": [{"executionSuccessful": true}],
      "results": [
        {
          "ruleId": "java/command-line-injection",
          "level": "error",
          "message": {"text": "This command depends on a user-provided value."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "src/main/java/example/UnsafeCommandServlet.java", "uriBaseId": "%SRCROOT%"},
                "region": {"startLine": 10, "startColumn": 9, "endLine": 10, "endColumn": 47}
              },
              "logicalLocations": [{"fullyQualifiedName": "example.UnsafeCommandServlet.execute"}]
            }
          ],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {
                      "kinds": ["source"],
                      "location": {
                        "message": {"text": "HTTP request parameter"},
                        "physicalLocation": {
                          "artifactLocation": {"uri": "src/main/java/example/UnsafeCommandServlet.java"},
                          "region": {"startLine": 8, "startColumn": 26, "endLine": 8, "endColumn": 57}
                        }
                      }
                    },
                    {
                      "location": {
                        "message": {"text": "Value is propagated through trim"},
                        "physicalLocation": {
                          "artifactLocation": {"uri": "src/main/java/example/UnsafeCommandServlet.java"},
                          "region": {"startLine": 9, "startColumn": 28, "endLine": 9, "endColumn": 42}
                        }
                      }
                    },
                    {
                      "kinds": ["sink"],
                      "location": {
                        "message": {"text": "Command execution sink"},
                        "physicalLocation": {
                          "artifactLocation": {"uri": "src/main/java/example/UnsafeCommandServlet.java"},
                          "region": {"startLine": 10, "startColumn": 9, "endLine": 10, "endColumn": 47}
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
