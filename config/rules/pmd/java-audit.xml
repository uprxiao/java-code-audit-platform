<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Java Code Audit Platform PMD rules"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/schema/ruleset_2_0_0.xsd">
    <description>Source-level correctness, resource, performance and maintainability checks for Java 17.</description>
    <rule ref="category/java/errorprone.xml">
        <exclude name="AvoidBranchingStatementAsLastInLoop"/>
    </rule>
    <rule ref="category/java/bestpractices.xml">
        <exclude name="GuardLogStatement"/>
    </rule>
    <rule ref="category/java/performance.xml"/>
    <rule ref="category/java/design.xml">
        <exclude name="LawOfDemeter"/>
        <exclude name="LoosePackageCoupling"/>
    </rule>
</ruleset>
