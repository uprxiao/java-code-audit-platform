<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Reviewed platform-only false positives. Suppressions are constrained by pattern and class. -->
  <Match>
    <!-- DTD, external entities/schema and XInclude are disabled before parsing. -->
    <Bug pattern="XXE_DOCUMENT"/>
    <Class name="io.github.uprxiao.audit.intake.MavenProjectInspector"/>
  </Match>
  <Match>
    <!-- Commands are validated argument arrays; shells and unapproved executables are rejected. -->
    <Bug pattern="COMMAND_INJECTION"/>
    <Class name="io.github.uprxiao.audit.process.LocalProcessExecutionBackend"/>
  </Match>
  <Match>
    <!-- LdapName parses a trusted X.509 subject DN; it never executes an LDAP query. -->
    <Bug pattern="LDAP_INJECTION"/>
    <Class name="io.github.uprxiao.audit.intake.SvnKitSourceCheckout$HostnameCheckingTrustManager"/>
  </Match>
  <Match>
    <!-- Every untrusted report value passes the local HTML escape routine before append. -->
    <Bug pattern="POTENTIAL_XML_INJECTION"/>
    <Class name="io.github.uprxiao.audit.report.ReportGenerator"/>
  </Match>
  <Match>
    <!-- The assignment detector has no nested ambiguous repetition; adversarial tests cover redaction. -->
    <Bug pattern="REDOS"/>
    <Class name="io.github.uprxiao.audit.finding.SensitiveDataRedactor"/>
  </Match>
  <Match>
    <!-- Maven version output is server-controlled and bounded by the process log limit. -->
    <Bug pattern="REDOS"/>
    <Class name="io.github.uprxiao.audit.api.StandardAnalysisToolIntegrityChecker"/>
  </Match>
  <Match>
    <!-- Maven version output is server-controlled and bounded by the process log limit. -->
    <Bug pattern="REDOS"/>
    <Class name="io.github.uprxiao.audit.api.StartupPrerequisiteChecker"/>
  </Match>
</FindBugsFilter>
