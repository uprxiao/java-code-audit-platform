#!/usr/bin/env bash
set -uo pipefail

WRAPPER_DIRECTORY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UPSTREAM="$WRAPPER_DIRECTORY/osv-scanner.real"
if [[ ! -x "$UPSTREAM" ]]; then
  echo "OSV_SCANNER_UPSTREAM_UNAVAILABLE: $UPSTREAM" >&2
  exit 127
fi

"$UPSTREAM" "$@"
exit_code=$?
case "$exit_code" in
  0|1) exit 0 ;; # OSV documents 1 as vulnerabilities found, not a scanner failure.
  *) exit "$exit_code" ;;
esac
